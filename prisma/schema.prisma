generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  name        String
  description String?

  links       ProfileLink[]
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
  educations  Education[]
}

model ProfileLink {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @db.Uuid
  label     String
  url       String
  sortOrder Int    @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model Skill {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @db.Uuid
  name      String
  sortOrder Int    @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model Experience {
  id           String    @id @default(uuid()) @db.Uuid
  profileId    String    @db.Uuid
  company      String
  position     String
  achievements String[]
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  sortOrder    Int       @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model Project {
  id            String  @id @default(uuid()) @db.Uuid
  profileId     String  @db.Uuid
  name          String
  description   String?
  url           String?
  repositoryUrl String?
  sortOrder     Int     @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model Education {
  id        String    @id @default(uuid()) @db.Uuid
  profileId String    @db.Uuid
  name      String
  degree    String
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
